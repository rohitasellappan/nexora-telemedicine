# Backend API and Socket.IO Signaling Server URL
# Set this to the public URL of your deployed Node.js backend on Render/Railway.
# Example: https://nexora-backend.onrender.com or https://api.yourdomain.com
VITE_API_URL=https://your-nexora-backend.onrender.com
# Alternatively, VITE_BACKEND_URL is also supported:
# VITE_BACKEND_URL=https://your-nexora-backend.onrender.com
